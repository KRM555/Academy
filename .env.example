# Noor & Bayan Academy Environment Configuration
# Copy this file to .env and configure the values before starting in production.

# PORT: The port the backend server listens on.
# In development, defaults to 3000 to match AI Studio dev environment.
# In production on Cloud Run, PORT is automatically injected by the platform.
PORT=3000

# APP_URL: Public URL where this applet is hosted.
APP_URL="https://example.com"

# JWT_SECRET: Strong secret key (min 32 random characters) used for signing auth cookies.
# Generate with: openssl rand -base64 32
JWT_SECRET="CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32"

# ENCRYPTION_KEY: 32-byte hex-encoded key for AES-256-GCM encryption of sensitive financial details (e.g. IBAN).
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY="CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32"

# Initial Admin Credentials (Seeded on first startup if user store is empty):
# ADMIN_EMAIL: Admin login email address.
ADMIN_EMAIL="admin@noor-bayan.com"
# ADMIN_PASSWORD_HASH: Bcrypt hash of initial admin password.
# Generate with: node -e "console.log(require('bcryptjs').hashSync('YOUR_STRONG_PASSWORD', 12))"
ADMIN_PASSWORD_HASH="$2a$12$e8Yx/Y3K3k6vC4Xz9sXJpe0aGq1Zp9Hj0iQ8lX2.g9rS2r5b7y6uO"

# DATABASE_URL: PostgreSQL connection string.
# Example: postgres://username:password@cloudsql-proxy-or-host:5432/noor_bayan
# Note: Cloud Run containers have ephemeral filesystems. Persistent relational storage requires Postgres.
DATABASE_URL=""
